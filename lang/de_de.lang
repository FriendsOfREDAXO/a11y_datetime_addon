a11y_datetime_yform_description = a11y_datetime Datum/Zeit Feld mit Standard-Settings und Expert-JSON
a11y_datetime_yform_picker_type = Feldtyp
a11y_datetime_yform_picker_type_notice = Für Datumsbereiche sollte die Datenbankspalte als varchar oder text angelegt werden, nicht als date/datetime.
a11y_datetime_yform_db_type_notice = Den Datenbank-Feldtyp bitte passend zum gewählten Feldtyp manuell setzen: Datum = date, Datum & Uhrzeit = datetime, Uhrzeit = time, Datumsbereich = varchar oder text.
a11y_datetime_yform_type_date = Datum
a11y_datetime_yform_type_datetime = Datum & Uhrzeit
a11y_datetime_yform_type_time = Uhrzeit
a11y_datetime_yform_type_date_range = Datumsbereich
a11y_datetime_yform_default = Standardwert
a11y_datetime_yform_current_value = Aktuellen Wert bei neuen Datensätzen vorbelegen
a11y_datetime_yform_locale = Locale
a11y_datetime_yform_calendar_title = Kalender-Titel
a11y_datetime_yform_calendar_title_notice = Text in der Titelleiste des Kalenders und als aria-label. Leer lassen, dann bleibt der Vendor-Default „Calendar“.
a11y_datetime_yform_date_format = Date-Format (optional)
a11y_datetime_yform_date_format_notice = Kann leer bleiben. Dann wird das passende Speicherformat automatisch aus dem Feldtyp abgeleitet, z. B. Y-m-d, Y-m-d H:i oder H:i.
a11y_datetime_yform_alt_format = Alt-Format / Anzeigeformat (optional)
a11y_datetime_yform_alt_format_notice = Format für die sichtbare Anzeige, z. B. Y-m-d H:i oder d.m.Y H:i. Hier gehören Format-Token hinein, keine Zahl.
a11y_datetime_yform_minute_increment = Minuten-Schrittweite
a11y_datetime_yform_show_months = Sichtbare Monate
a11y_datetime_yform_show_months_notice = Maximale Anzahl der gleichzeitig sichtbaren Kalenderblätter. Auf schmalen Breiten wird automatisch auf 1 oder 2 reduziert. Gilt fuer den Kalender allgemein, nicht nur im Inline-Modus.
a11y_datetime_yform_mobile_range_mode = Mobile-Verhalten für Datumsbereich
a11y_datetime_yform_mobile_range_mode_default = Standard (Range-Picker auch mobil)
a11y_datetime_yform_mobile_range_mode_split = Native Mobile-Eingabe (Start/Ende getrennt)
a11y_datetime_yform_mobile_range_mode_notice = Nur für Feldtyp Datumsbereich. Bei „Native Mobile-Eingabe“ werden auf Mobilgeräten zwei native Datumsfelder (Start/Ende) angezeigt und intern als Datumsbereich gespeichert.
a11y_datetime_yform_mobile_range_start = Startdatum
a11y_datetime_yform_mobile_range_end = Enddatum
a11y_datetime_yform_year_range_past = Jahre zurück
a11y_datetime_yform_year_range_future = Jahre voraus
a11y_datetime_yform_year_range_notice = Jahresbereich relativ zu heute, den der Kalender anzeigt.
a11y_datetime_yform_enable_seconds = Sekunden aktivieren
a11y_datetime_yform_time_24hr = 24-Stunden-Modus
a11y_datetime_yform_allow_input = Direkte Eingabe erlauben
a11y_datetime_yform_focus_opens = Bei Fokus öffnen
a11y_datetime_yform_inline = Inline-Kalender anzeigen
a11y_datetime_yform_month_year_wheel = Monat/Jahr-Wheel aktivieren
a11y_datetime_yform_show_month_nav_arrows = Monats-Pfeile anzeigen
a11y_datetime_yform_year_wheel_manual_input = Manuelle Jahreingabe im Wheel
a11y_datetime_yform_disable_dates = Ausgeschlossene Termine
a11y_datetime_yform_disable_dates_notice = Kommaseparierte Liste von Datumswerten, z. B. 2026-12-24,2026-12-25
a11y_datetime_yform_disable_callback = Externer Disable-Callback
a11y_datetime_yform_disable_callback_notice = Globaler JavaScript-Pfad, z. B. window.MyApp.a11yDatetimeDisabledDates. Rückgabe: Array oder Disable-Funktion.
a11y_datetime_yform_expert_json = Expert-JSON
a11y_datetime_yform_expert_json_notice = Zusätzliche a11y_datetime-/Flatpickr-Optionen als JSON-Objekt. Wird nach den Standard-Settings gemerged.
a11y_datetime_yform_summary_type = Typ: %s
a11y_datetime_yform_summary_minute_increment = Minuten: %s
a11y_datetime_yform_summary_locale = Locale: %s
a11y_datetime_yform_summary_calendar_title = Titel: %s
a11y_datetime_yform_summary_disable_callback = Disable-Callback: %s
a11y_datetime_yform_summary_expert_json = Expert-JSON aktiv
