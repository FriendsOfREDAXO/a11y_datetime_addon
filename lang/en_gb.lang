a11y_datetime_yform_description = a11y_datetime date/time field with common settings and expert JSON
a11y_datetime_yform_picker_type = Field type
a11y_datetime_yform_picker_type_notice = For date ranges, the database column should use varchar or text, not date/datetime.
a11y_datetime_yform_db_type_notice = Please set the database field type manually to match the chosen field type: Date = date, Date & Time = datetime, Time = time, Date range = varchar or text.
a11y_datetime_yform_type_date = Date
a11y_datetime_yform_type_datetime = Date & Time
a11y_datetime_yform_type_time = Time
a11y_datetime_yform_type_date_range = Date range
a11y_datetime_yform_default = Default value
a11y_datetime_yform_current_value = Prefill current value for new records
a11y_datetime_yform_locale = Locale
a11y_datetime_yform_calendar_title = Calendar title
a11y_datetime_yform_calendar_title_notice = Text in the calendar title bar and as aria-label. Leave empty to keep the vendor default "Calendar".
a11y_datetime_yform_date_format = Date format (optional)
a11y_datetime_yform_date_format_notice = Can be left empty. The appropriate storage format is then chosen automatically from the field type, e.g. Y-m-d, Y-m-d H:i, or H:i.
a11y_datetime_yform_alt_format = Alt/display format (optional)
a11y_datetime_yform_alt_format_notice = Format for the visible display, e.g. Y-m-d H:i or d.m.Y H:i. Enter format tokens here, not a number.
a11y_datetime_yform_minute_increment = Minute increment
a11y_datetime_yform_show_months = Visible months
a11y_datetime_yform_show_months_notice = Maximum number of calendar panels shown at the same time. On narrow widths it is automatically reduced to 1 or 2. This applies to the calendar in general, not just inline mode.
a11y_datetime_yform_mobile_range_mode = Mobile behavior for date range
a11y_datetime_yform_mobile_range_mode_default = Default (range picker on mobile)
a11y_datetime_yform_mobile_range_mode_split = Native mobile input (separate start/end)
a11y_datetime_yform_mobile_range_mode_notice = Only used for date range fields. With “Native mobile input”, mobile devices render two native date inputs (start/end) while storing the combined date range value internally.
a11y_datetime_yform_mobile_range_start = Start date
a11y_datetime_yform_mobile_range_end = End date
a11y_datetime_yform_year_range_past = Years back
a11y_datetime_yform_year_range_future = Years ahead
a11y_datetime_yform_year_range_notice = Year range relative to today shown by the calendar.
a11y_datetime_yform_enable_seconds = Enable seconds
a11y_datetime_yform_time_24hr = 24 hour mode
a11y_datetime_yform_allow_input = Allow direct input
a11y_datetime_yform_focus_opens = Open on focus
a11y_datetime_yform_inline = Render inline calendar
a11y_datetime_yform_month_year_wheel = Enable month/year wheel
a11y_datetime_yform_show_month_nav_arrows = Show month navigation arrows
a11y_datetime_yform_year_wheel_manual_input = Manual year input in wheel
a11y_datetime_yform_disable_dates = Disabled dates
a11y_datetime_yform_disable_dates_notice = Comma-separated list of dates, e.g. 2026-12-24,2026-12-25
a11y_datetime_yform_disable_callback = External disable callback
a11y_datetime_yform_disable_callback_notice = Global JavaScript path, e.g. window.MyApp.a11yDatetimeDisabledDates. Return value: array or disable function.
a11y_datetime_yform_expert_json = Expert JSON
a11y_datetime_yform_expert_json_notice = Additional a11y_datetime/Flatpickr options as JSON object. Merged after common settings.
